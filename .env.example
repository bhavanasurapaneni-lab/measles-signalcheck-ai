# Copy this file to .env and fill in real values YOURSELF.
# .env is git-ignored, so your key will never be committed.
# Never paste an API key into chat, issues, logs or commits.

# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Model and settings for investigation briefs (Milestone 5)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=8000
