{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/measles-signalcheck-ai/schemas/evidence_packet.schema.json",
  "title": "Measles SignalCheck AI evidence packet",
  "description": "Aggregate, traceable evidence for one unit and one pair of comparable years. Facts are observed values; derived values are calculations with explicit methods; signals are review triggers, never causal findings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_version", "generated_by", "source", "scope", "facts", "derived", "signals", "limitations", "prohibited_interpretations"],
  "properties": {
    "packet_version": {"type": "string", "enum": ["1.0"]},
    "generated_by": {
      "type": "object", "additionalProperties": false,
      "required": ["rules_version", "config_version", "config_sha256"],
      "properties": {
        "rules_version": {"type": "string"},
        "config_version": {"type": "string"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "data_card", "files"],
      "properties": {
        "source_id": {"type": "string"},
        "data_card": {"type": "string"},
        "files": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["file", "sha256", "retrieved_at_utc"],
            "properties": {
              "file": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "retrieved_at_utc": {"type": "string"}
            }
          }
        }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_code", "unit_name", "admin1_code", "year_from", "year_to", "comparable", "system_transitions_crossed"],
      "properties": {
        "unit_code": {"type": "string", "pattern": "^[0-9]{6}$"},
        "unit_name": {"type": "string"},
        "admin1_code": {"type": "string"},
        "year_from": {"type": "integer"},
        "year_to": {"type": "integer"},
        "comparable": {"type": "boolean", "enum": [true]},
        "system_transitions_crossed": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "measure", "unit_code", "year", "value", "unit", "attribution", "source_file", "role"],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]+$"},
          "measure": {"type": "string", "enum": ["doses_administered", "published_coverage_pct", "live_births"]},
          "unit_code": {"type": "string"},
          "year": {"type": "integer"},
          "value": {"type": ["number", "null"]},
          "unit": {"type": "string", "enum": ["count", "percent"]},
          "attribution": {"type": "string", "enum": ["place_of_recording", "mother_residence", "as_published"]},
          "source_file": {"type": "string"},
          "role": {"type": "string", "enum": ["observed", "independent_reference"]}
        }
      }
    },
    "derived": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "method", "inputs", "value", "unit", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^D[0-9]+$"},
          "name": {"type": "string"},
          "method": {"type": "string"},
          "inputs": {"type": "array", "items": {"type": "string", "pattern": "^[FD][0-9]+$"}},
          "value": {"type": ["number", "null"]},
          "unit": {"type": "string", "enum": ["count", "percent", "percentage_points", "ratio", "share"]},
          "label": {"type": "string", "enum": ["observed_change", "back_calculated_not_observed", "mathematical_decomposition", "state_benchmark_weighted", "independent_reference_change"]}
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "classification", "rule_id", "threshold", "statement", "evidence", "cautions", "cannot_conclude"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]+$"},
          "classification": {"type": "string", "enum": ["recorded_dose_change", "reported_coverage_change", "implausible_coverage", "state_benchmark_divergence", "small_denominator_caution", "insufficient_evidence"]},
          "rule_id": {"type": "string"},
          "threshold": {"type": ["object", "null"]},
          "statement": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[FD][0-9]+$"}},
          "cautions": {"type": "array", "items": {"type": "string"}},
          "cannot_conclude": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {"id": {"type": "string", "pattern": "^L[0-9]+$"}, "text": {"type": "string"}}
      }
    },
    "prohibited_interpretations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
